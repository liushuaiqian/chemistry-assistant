# 化学助手项目 Docker 环境变量配置文件
# 请根据实际情况填写相应的API密钥和配置

# ===========================================
# API密钥配置 (必填项)
# ===========================================

# 智谱AI API密钥 (推荐)
ZHIPU_API_KEY=your_zhipu_api_key_here

# 通义千问API密钥 (推荐)
TONGYI_API_KEY=your_tongyi_api_key_here

# OpenAI API密钥
OPENAI_API_KEY=your_openai_api_key_here

# Claude API密钥 (硅基流动)
CLAUDE_API_KEY=your_claude_api_key_here

# 硅基流动API密钥
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 百度千帆API密钥
QIANFAN_API_KEY=your_qianfan_api_key_here

# Metaso搜索API密钥
METASO_API_KEY=your_metaso_api_key_here

# 通义知识库API配置
TONGYI_KNOWLEDGE_API_KEY=your_tongyi_knowledge_api_key_here
TONGYI_KNOWLEDGE_APP_ID=your_tongyi_knowledge_app_id_here

# ===========================================
# 应用配置
# ===========================================

# Web服务端口
WEB_PORT=7860

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 功能开关
ENABLE_ADAPTIVE=true
USE_RERANKER=true
DISABLE_RERANKER=false

# 模型配置
DEFAULT_MODEL=zhipu
EMBEDDING_MODEL=bge-large-zh-v1.5
USE_API_EMBEDDING=true
API_EMBEDDING_PROVIDER=tongyi

# ===========================================
# 数据库和缓存配置
# ===========================================

# Redis配置 (如果启用)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 向量数据库配置
VECTOR_STORE_PATH=/app/data/vector_store
TEXTBOOKS_PATH=/app/data/textbooks
QUESTION_BANK_PATH=/app/data/question_bank

# ===========================================
# 安全配置
# ===========================================

# JWT密钥 (如果启用认证)
JWT_SECRET_KEY=your_jwt_secret_key_here

# 允许的主机
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS配置
CORS_ORIGINS=*

# ===========================================
# 性能配置
# ===========================================

# 并发配置
MAX_WORKERS=4
MAX_CONCURRENT_REQUESTS=10

# 超时配置
REQUEST_TIMEOUT=60
API_TIMEOUT=30
KNOWLEDGE_API_TIMEOUT=50

# 缓存配置
ENABLE_CACHE=true
CACHE_TTL=3600

# ===========================================
# 监控和调试配置
# ===========================================

# 性能监控
ENABLE_PERFORMANCE_MONITOR=true
MONITOR_INTERVAL=60

# 调试模式
DEBUG_MODE=false
VERBOSE_LOGGING=false

# 健康检查
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# ===========================================
# 外部服务配置
# ===========================================

# Ngrok配置 (如果需要外网访问)
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
ENABLE_NGROK=false

# 邮件通知配置 (可选)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===========================================
# 备注说明
# ===========================================
# 1. 请将 'your_*_here' 替换为实际的API密钥
# 2. 至少需要配置一个AI模型的API密钥才能正常运行
# 3. 推荐配置智谱AI和通义千问的API密钥以获得最佳体验
# 4. 生产环境请确保API密钥的安全性
# 5. 可以根据需要启用或禁用相关功能