*.pkl
*.pickle
*.h5
*.hdf5
*.parquet

# 模型文件 (如果很大)
*.bin
*.safetensors
models/local_model/

# 向量存储 (如果很大，建议通过挂载卷提供)
# data/vector_store/

# 教材文件 (如果很大)
# data/textbooks/

# ===========================================
# 配置文件 (敏感信息)
# ===========================================
.env
.env.local
.env.*.local
config_secure.py

# API密钥文件
data/keys/
*.key
*.pem
*.crt

