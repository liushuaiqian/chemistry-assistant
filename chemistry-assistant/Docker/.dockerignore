# 化学助手项目 Docker 忽略文件
# 指定在构建Docker镜像时需要忽略的文件和目录

# ===========================================
# 版本控制
# ===========================================
.git
.gitignore
.gitattributes
.github/

# ===========================================
# Python相关
# ===========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
PYMANIFEST

# ===========================================
# 虚拟环境
# ===========================================
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

