# 化学助手环境变量配置模板
# 复制此文件为 .env 并填入实际的API密钥

# =============================================================================
# API密钥配置
# =============================================================================

# 智谱AI API密钥
CHEMISTRY_ASSISTANT_ZHIPU_API_KEY=your_zhipu_api_key_here

# 通义千问 API密钥
CHEMISTRY_ASSISTANT_TONGYI_API_KEY=your_tongyi_api_key_here

# OpenAI API密钥（可选）
CHEMISTRY_ASSISTANT_OPENAI_API_KEY=your_openai_api_key_here

# Claude API密钥（可选）
CHEMISTRY_ASSISTANT_CLAUDE_API_KEY=your_claude_api_key_here

# 百度千帆 API密钥（可选）
CHEMISTRY_ASSISTANT_QIANFAN_API_KEY=your_qianfan_api_key_here

# Metaso API密钥（可选）
CHEMISTRY_ASSISTANT_METASO_API_KEY=your_metaso_api_key_here

# =============================================================================
# 系统配置
# =============================================================================

# 主密钥（用于加密存储的API密钥）
CHEMISTRY_ASSISTANT_MASTER_KEY=your_master_key_here

# 密码（用于生成主密钥）
CHEMISTRY_ASSISTANT_PASSWORD=your_secure_password_here

# =============================================================================
# 应用配置
# =============================================================================

# Web服务端口
CHEMISTRY_ASSISTANT_WEB_PORT=7860

# 日志级别
CHEMISTRY_ASSISTANT_LOG_LEVEL=INFO

# 主题
CHEMISTRY_ASSISTANT_THEME=light

# =============================================================================
# 安全配置
# =============================================================================

# 启用API限流
CHEMISTRY_ASSISTANT_RATE_LIMIT_ENABLED=true

# 每分钟请求限制
CHEMISTRY_ASSISTANT_RATE_LIMIT_RPM=60

# 每小时请求限制
CHEMISTRY_ASSISTANT_RATE_LIMIT_RPH=1000

# 最大查询长度
CHEMISTRY_ASSISTANT_MAX_QUERY_LENGTH=10000

# 最大图片大小（MB）
CHEMISTRY_ASSISTANT_MAX_IMAGE_SIZE_MB=10

# 会话超时时间（分钟）
CHEMISTRY_ASSISTANT_SESSION_TIMEOUT=30
